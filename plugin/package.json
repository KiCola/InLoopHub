{
  "name": "inloop-obsidian-plugin",
  "version": "0.1.0",
  "description": "InLoop 手记的 Obsidian 界面：新建文章、实时渲染预览、构建并复制到微信公众号",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node esbuild.config.mjs",
    "dev": "node esbuild.config.mjs --watch",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run build",
    "deploy": "node esbuild.config.mjs --deploy",
    "install-to-vault": "node scripts/link-vault.mjs",
    "unlink-vault": "node scripts/link-vault.mjs --remove"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "builtin-modules": "^4.0.0",
    "esbuild": "^0.28.2",
    "obsidian": "^1.13.1",
    "typescript": "^5.7.2"
  }
}
